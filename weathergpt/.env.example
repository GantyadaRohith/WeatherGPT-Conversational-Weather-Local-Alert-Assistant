# ========================================================
# WeatherGPT Environment Configuration
# Track A · A2: Conversational Weather & Local Alert Assistant
# ========================================================

# Active LLM Provider: "local" (default/free/zero-key), "groq", "gemini", or "openai"
WEATHER_LLM_PROVIDER=local

# API Keys (Fill in if you want to use cloud-hosted LLM reasoning)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Models Configuration
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Default Pinned Location for Fixed Weather Hero
DEFAULT_CITY=New Delhi

# ========================================================
# Database Configuration (Track A · A2 Requirement)
# Connects to MongoDB Atlas or local MongoDB; auto-falls back to persistent JSON document store
# ========================================================
MONGODB_URI=
MONGODB_DB=weathergpt

# ========================================================
# Notification System (Track A · A2 Requirement)
# Twilio SMS / WhatsApp or Meta WhatsApp Cloud API
# When keys are blank, system runs in Evaluator Live Simulation Mode
# ========================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
