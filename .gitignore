# ========================================================
# Git Ignore - WeatherGPT (Capabl Agentic AI Hackathon)
# ========================================================

# --- Sensitive Environment & Secrets (NEVER COMMIT) ---
.env
*.env
.env.*
!.env.example

# --- Python Virtual Environments & Bytecode ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
build/
dist-py/
*.egg-info/

# --- Node.js & React Frontend (Vite) ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
**/dist/
dist-ssr/
*.local

# --- IDEs, Editors & Temporary Files ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Operating System Caches ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Agentic Workspaces & Local IDE Artifacts ---
.gemini/
.agents/
.system_generated/
